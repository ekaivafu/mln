{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/records-dashboard", "destination": "/records.html" },
    { "source": "/records-dashboard/", "destination": "/records.html" },
    { "source": "/records-dashboard/records.html", "destination": "/records.html" },
    { "source": "/records-dashboard/(.*)", "destination": "/$1" },
    { "source": "/MLN-Alliance-MediaCrew", "destination": "/index.html" },
    { "source": "/MLN-Alliance-MediaCrew/", "destination": "/index.html" },
    { "source": "/MLN-Alliance-MediaCrew/index", "destination": "/index.html" },
    { "source": "/MLN-Alliance-MediaCrew/index.html", "destination": "/index.html" },
    { "source": "/MLN-Alliance-MediaCrew/register", "destination": "/register.html" },
    { "source": "/MLN-Alliance-MediaCrew/register.html", "destination": "/register.html" },
    { "source": "/MLN-Alliance-MediaCrew/id", "destination": "/id.html" },
    { "source": "/MLN-Alliance-MediaCrew/id.html", "destination": "/id.html" },
    { "source": "/MLN-Alliance-MediaCrew/functions", "destination": "/functions.html" },
    { "source": "/MLN-Alliance-MediaCrew/functions.html", "destination": "/functions.html" },
    { "source": "/MLN-Alliance-MediaCrew/thankyou", "destination": "/thankyou.html" },
    { "source": "/MLN-Alliance-MediaCrew/thankyou.html", "destination": "/thankyou.html" },
    { "source": "/MLN-Alliance-MediaCrew/records", "destination": "/records.html" },
    { "source": "/MLN-Alliance-MediaCrew/records.html", "destination": "/records.html" },
    { "source": "/MLN-Alliance-MediaCrew/(.*)", "destination": "/$1" }
  ]
}

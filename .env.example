# ==============================================================================
# MLN ALLIANCE MEDIACREW — EMAIL API CONFIGURATION
# Choose ANY ONE of the free APIs below!
# ==============================================================================

# ------------------------------------------------------------------------------
# API OPTION 1: Resend API (RECOMMENDED for Vercel — 100% Free, 3,000 emails/month)
# 1. Sign up for free at https://resend.com (takes 1 minute with Google/GitHub)
# 2. Go to "API Keys" -> Create API Key -> Copy it here
# 3. On Vercel: Add RESEND_API_KEY in Project Settings -> Environment Variables
# ------------------------------------------------------------------------------
RESEND_API_KEY=

# ------------------------------------------------------------------------------
# API OPTION 2: Brevo API / Sendinblue (Free 300 emails/day = 9,000/month, NO custom domain needed)
# 1. Sign up at https://brevo.com (free, no credit card)
# 2. Go to SMTP & API -> API Keys -> Generate a new API Key
# 3. On Vercel: Add BREVO_API_KEY and BREVO_SENDER in Environment Variables
# ------------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER=mlnalliancemediacrew@gmail.com

# ------------------------------------------------------------------------------
# API OPTION 3: Gmail SMTP (Free 500 emails/day from your personal Gmail)
# 1. Google Account -> Security -> Enable 2-Step Verification
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App named "MLN Portal" and copy the 16-character password
# ------------------------------------------------------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Security Secret for Stateless Cryptographic OTP Verification (No database needed)
OTP_SECRET=mln-alliance-mediacrew-production-key-2026
